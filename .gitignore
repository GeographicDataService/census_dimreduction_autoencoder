notebooks/plots/**
!notebooks/plots/**/
!notebooks/plots/**/.gitkeep
notebooks/logs_lad/**
!notebooks/logs_lad/.gitkeep

# Backups
*.bak*

# Vendored package build artifacts
torchgeodemo/build/
torchgeodemo/src/*.egg-info/
